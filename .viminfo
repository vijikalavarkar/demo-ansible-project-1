""1	LINE	0
	<!doctype html>
	<html lang="en">
	<head>
	  <meta charset="utf-8" />
	  <meta name="viewport" content="width=device-width,initial-scale=1" />
	  <title>Planty — Grow with Joy</title>
	  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
	  <style>
	    :root{
	      --bg: #2b1d12;
	      --glass: rgba(255,255,255,0.06);
	      --accent: #c4a484;
	      --muted: rgba(255,255,255,0.75);
	      --card: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
	    }
	    *{box-sizing:border-box}
	    html,body{height:100%}
	    body{
	      margin:0;
	      font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
	      background: radial-gradient(1200px 600px at 10% 10%, rgba(196,164,132,0.06), transparent),
	                  radial-gradient(700px 400px at 90% 90%, rgba(110,72,44,0.06), transparent),
	                  var(--bg);
	      color: #f4e9dd;
	      -webkit-font-smoothing:antialiased;
	      -moz-osx-font-smoothing:grayscale;
	      overflow-x:hidden;
	    }
	
	    .container{max-width:1100px;margin:48px auto;padding:0 24px}
	    header{display:flex;align-items:center;justify-content:space-between;padding:18px 0}
	    .brand{display:flex;gap:14px;align-items:center}
	    .logo{
	      width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#c4a484,#8b5e3c);display:grid;place-items:center;box-shadow:0 6px 18px rgba(12,8,4,0.6);
	      flex-shrink:0
	    }
	    .logo svg{filter:drop-shadow(0 6px 12px rgba(0,0,0,0.4))}
	    .brand h1{font-size:18px;margin:0;font-weight:700;letter-spacing:0.2px}
	    .brand p{margin:0;font-size:12px;color:var(--muted)}
	
	    nav{display:flex;gap:18px;align-items:center}
	    nav a{color:var(--muted);text-decoration:none;font-weight:600;font-size:14px}
	    .btn-ghost{padding:8px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.1);background:transparent;color:var(--muted)}
	    .btn-primary{background:linear-gradient(90deg,var(--accent),#8b5e3c);color:#2b1d12;padding:10px 16px;border-radius:12px;font-weight:700;border:none}
	
	    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center;margin-top:32px}
	    .hero-left h2{font-size:44px;line-height:1.02;margin:0}
	    .tag{display:inline-block;margin-top:12px;padding:6px 10px;border-radius:999px;background:var(--glass);color:var(--accent);font-weight:700;font-size:13px}
	    .hero-left p{color:var(--muted);margin-top:18px;font-size:16px}
	    .ctas{display:flex;gap:12px;margin-top:24px}
